{
  "name": "video-effects",
  "displayName": "Video Effects",
  "version": "0.1.0",
  "description": "Live color, geometry, and playback controls for HTML5 videos.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.8.2"
  },
  "manifest": {
    "permissions": [
      "storage",
      "downloads",
      "declarativeNetRequest"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "optional_host_permissions": [
      "*://*.doubleclick.net/*",
      "*://doubleclick.net/*",
      "*://*.googlesyndication.com/*",
      "*://googlesyndication.com/*",
      "*://*.googleadservices.com/*",
      "*://googleadservices.com/*",
      "*://*.googletagservices.com/*",
      "*://googletagservices.com/*",
      "*://*.2mdn.net/*",
      "*://2mdn.net/*",
      "*://adservice.google.com/*",
      "*://*.youtube.com/*",
      "*://youtube.com/*",
      "*://ads.hotstar.com/*",
      "*://*.ads.hotstar.com/*",
      "*://ads.jiohotstar.com/*",
      "*://*.ads.jiohotstar.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "video-effects@localhost"
      }
    }
  }
}
